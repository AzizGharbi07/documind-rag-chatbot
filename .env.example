# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
# Values below are for running the backend on your host (`just dev-api`).
# docker-compose.yml overrides the service URLs with container addresses.

APP_ENV=dev
LOG_LEVEL=INFO

# --- Postgres (metadata, sessions) ---
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=documind
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://documind:change-me@localhost:5432/documind

# --- Qdrant (vectors) ---
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documind_chunks

# --- Ollama (LLM + embeddings) ---
# Host-run backend talks to host Ollama directly:
OLLAMA_BASE_URL=http://localhost:11434
# The api container reaches host Ollama via host.docker.internal.
# Use http://ollama:11434 with `docker compose --profile ollama up`.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# CPU-friendly defaults for a 16 GB laptop (~3 GB download in total).
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=bge-m3

# --- Ports exposed on the host ---
API_PORT=8000
WEB_PORT=3000
